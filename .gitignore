# Gradle and Java build output
.gradle/
build/
out/
*.class

# Local Minecraft development instances and logs
run/
runs/
logs/
crash-reports/
*.log
__pycache__/
*.py[cod]
.pytest_cache/

# Build artifacts and local pipeline dependencies
src/main/resources/data/relics/structure/
structures-src/generated/
# Publish asset reviews, editable sources, usable exports and provenance.
# Keep render scenes, intermediates, tile manifests and nested tile folders local.
relics/*/design/generated/*
!relics/*/design/generated/*/
relics/*/design/generated/*/*
!relics/*/design/generated/*/*review.png
!relics/*/design/generated/*/*.nbt
!relics/*/design/generated/*/*-source.blend
!relics/*/design/generated/*/*.schem
!relics/*/design/generated/*/*.design.json
!relics/*/design/generated/*/*.ots.json
!relics/*/design/generated/*/verification.json
!relics/*/design/generated/*/*.gameplay.json
# V7's complete handoff binds its review inputs, mesh groups and all NBT tiles.
!relics/colossus/design/generated/colossus-v7-landmarks/**
relics/colossus/design/generated/colossus-v7-landmarks/*.blend1
!relics/colossus/design/generated/small-colossus-v10-landmarks/**
relics/colossus/design/generated/small-colossus-v10-landmarks/*.blend1
!relics/colossus/design/generated/small-colossus-v11-short-entry/**
relics/colossus/design/generated/small-colossus-v11-short-entry/*.blend1
!relics/ruined-tower/design/generated/ruined-tower-v10-chest/**
!relics/ruined-tower/design/generated/ruined-tower-v11-upper-chest/**
relics/ruined-tower/design/generated/ruined-tower-v11-upper-chest/*.blend1
relics/ruined-tower/design/generated/ruined-tower-v10-chest/*.blend1
!relics/titan-skull/design/generated/titan-skull-2-v2-embedded-side-v1/**
relics/titan-skull/design/generated/titan-skull-2-v2-embedded-side-v1/*.blend1
# Archived concept outputs follow the same publication policy.
relics/*/archive/*/generated/*
!relics/*/archive/*/generated/*review.png
!relics/*/archive/*/generated/*.nbt
!relics/*/archive/*/generated/*-source.blend
!relics/*/archive/*/generated/*.schem
!relics/*/archive/*/generated/*.design.json
!relics/*/archive/*/generated/*.ots.json
!relics/*/archive/*/generated/verification.json
dist/
.work/

# IDE and operating system files
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db
Desktop.ini

# Local environment files
.env
.env.*
!.env.example
